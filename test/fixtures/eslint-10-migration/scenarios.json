        "files": {
            "package.json": "{\"packageManager\":\"yarn@4.6.0\",\"devDependencies\":{\"eslint\":\"^9.33.0\",\"eslint-config-facile\":\"^1.2.0\"},\"scripts\":{\"lint\":\"eslint .\"}}",
