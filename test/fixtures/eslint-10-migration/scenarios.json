    {
        "id": "pnpm-nested-monorepo",
        "manager": "pnpm",
        "files": {
            "package.json": "{\"private\":true,\"packageManager\":\"pnpm@10.18.0\",\"devDependencies\":{\"eslint\":\"^8.57.0\",\"eslint-config-facile\":\"^0.12.0\"},\"scripts\":{\"lint\":\"eslint packages\"}}",
            "pnpm-lock.yaml": "lockfileVersion: '9.0'\n",
            "pnpm-workspace.yaml": "packages:\n  - packages/*\n",
            ".eslintrc.json": "{\"extends\":\"facile\",\"rules\":{\"curly\":\"warn\"}}",
            "packages/api/.eslintrc.json": "{\"extends\":\"facile/node\",\"rules\":{\"no-console\":\"off\"}}",
            "packages/web/.eslintrc.json": "{\"extends\":\"facile/react\",\"rules\":{\"react/display-name\":\"warn\"}}",
            "packages/api/src/index.ts": "export const api = true\n",
            "packages/web/src/app.tsx": "export const App = () => <main />\n"
        },
        "expect": {
            "status": "completed",
            "preserve": ["root precedence", "api scope", "web scope"],
            "lockfile": "pnpm-lock.yaml"
        }
    },
