{
    "name": "eslint-config-facile",
    "version": "2.0.0-rc.0",
    "description": "facile.it ESLint extensible configuration",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/facile-it/eslint-config-facile.git"
    },
    "author": "Iacopo <siuvdlec@gmail.com>",
    "license": "MIT",
    "files": [
        "/dist"
    ],
    "type": "module",
    "module": "./dist/index.mjs",
    "exports": {
        "./package.json": "./package.json",
        "./prettierrc.json": "./dist/prettierrc.json",
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./*": {
            "types": "./dist/*.d.mts",
            "default": "./dist/*.mjs"
        }
    },
    "types": "./dist/index.d.mts",
    "scripts": {
        "tsc": "tsc",
        "prebuild": "rm -rf dist",
        "build": "tsc -p tsconfig.build.json && cp .prettierrc.json ./dist/prettierrc.json",
        "pretest": "npm run build",
        "test": "eslint ./test/. -c ./test/_config.mjs --ext .ts",
        "test:smoke": "node ./test/smoke.mjs",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "eslint": "^9.33.0 || ^10.0.0",
        "prettier": "^3.6.0",
        "typescript": "^4.0 || ^5.0 || ^6.0"
    },
    "dependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^9.33.0 || ^10.0.0",
        "@smarttools/eslint-plugin-rxjs": "^1.0.22",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint-config-expo": "^10.0.0",
        "eslint-config-next": "^16.3.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-fp-ts": "^0.6.0",
        "eslint-plugin-import-x": "^4.17.0",
        "eslint-plugin-n": "^18.3.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.3.0",
        "typescript-eslint": "^8.70.1"
    },
    "devDependencies": {
        "@facile-it/tsconfig": "^0.2.0",
        "@types/node": "^22.0.0",
        "@typescript-eslint/utils": "^8.70.1",
        "eslint": "^10.0.0",
        "prettier": "^3.6.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "overrides": {
        "eslint-plugin-import": {
            "eslint": "$eslint"
        },
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        },
        "eslint-plugin-react": {
            "eslint": "$eslint"
        },
        "eslint-plugin-react-hooks": {
            "eslint": "$eslint"
        }
    },
    "tags": [
        "eslint",
        "prettier",
        "configuration"
    ],
    "keywords": [
        "typescript",
        "react",
        "eslint",
        "eslintconfig",
        "prettier",
        "extensible",
        "configuration"
    ],
    "packageManager": "npm@10.9.0"
}
